{
  "name": "oplia-dr-mysql-billing",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "database.hostname": "billing-mysql.primary.internal",
    "database.port": "3306",
    "database.user": "debezium",
    "database.password": "${file:/opt/kafka/secrets/billing-mysql.properties:password}",
    "database.server.id": "184054",
    "topic.prefix": "cdc",
    "database.include.list": "billing",
    "include.schema.changes": "true",
    "schema.history.internal.kafka.bootstrap.servers": "kafka-bootstrap.oplia-data.svc:9093",
    "schema.history.internal.kafka.topic": "schema-history.billing",
    "skipped.operations": "none",
    "database.ssl.mode": "verify_identity"
  }
}
