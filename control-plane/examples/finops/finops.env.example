# OPLIA FinOps settings (environment variables). JSON values must be valid JSON.
# Inventory scopes - configure only the clouds you use.
OPLIA_FINOPS_AWS_REGIONS=["us-east-1","eu-west-1"]
OPLIA_FINOPS_AZURE_SUBSCRIPTIONS=["00000000-0000-0000-0000-000000000000"]
OPLIA_FINOPS_GCP_SCOPES=["organizations/123456789012"]
OPLIA_FINOPS_GCP_PROJECTS=["my-prod-project"]
OPLIA_FINOPS_IBM_ACCOUNT_ID=<ibm-account-id>
# The IBM API key is a secret: provide it as the secret named "ibm_cloud_api_key" (env: OPLIA_SECRET_IBM_CLOUD_API_KEY, or Vault).

# Tag policy (default: exact Owner, CostCenter, Environment; GCP labels owner/costcenter/environment).
OPLIA_FINOPS_POLICY={"allowed_environments": ["dev", "stg", "prod"]}
OPLIA_FINOPS_ALERT_CHANNELS=["slack"]

# Clean-ups run only inside these windows; with no window configured they never run.
OPLIA_FINOPS_MAINTENANCE_WINDOWS=[{"days": ["sat"], "start": "02:00", "end": "06:00", "tz": "Asia/Kolkata"}]
OPLIA_FINOPS_IDLE_GRACE_DAYS=7
OPLIA_FINOPS_PROPOSAL_TTL_HOURS=192
OPLIA_FINOPS_PROTECTED_ENVIRONMENTS=["prod","production","prd"]
OPLIA_FINOPS_SNAPSHOT_WAIT_SECONDS=1800
