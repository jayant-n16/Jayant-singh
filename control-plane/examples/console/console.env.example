# ConfigMap "oplia-console-config" for the console (no secrets: the console is a public OAuth client).
# kubectl -n oplia-system create configmap oplia-console-config --from-env-file=console.env
# See docs/console-login.md for creating the app registrations.

# --- Microsoft Entra ID ---
OPLIA_CONSOLE_AUTHORITY=https://login.microsoftonline.com/11111111-1111-1111-1111-111111111111/v2.0
OPLIA_CONSOLE_CLIENT_ID=22222222-2222-2222-2222-222222222222
OPLIA_CONSOLE_SCOPE=openid profile api://oplia-api/access

# --- or Okta (custom authorization server) ---
# OPLIA_CONSOLE_AUTHORITY=https://acme.okta.com/oauth2/aus1a2b3c4d5e6f7g8h9
# OPLIA_CONSOLE_CLIENT_ID=0oa1a2b3c4d5e6f7g8h9
# OPLIA_CONSOLE_SCOPE=openid profile

# Shown as a badge in the header (letters, digits, spaces . _ ( ) - ; max 60)
OPLIA_CONSOLE_ENVIRONMENT_LABEL=Production
