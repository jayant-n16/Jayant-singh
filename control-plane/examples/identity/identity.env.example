# Entra ID (app registration with application permissions; client secret in the secret store as "entra_client_secret")
OPLIA_IDENTITY_ENTRA_TENANT_ID=<tenant-guid>
OPLIA_IDENTITY_ENTRA_CLIENT_ID=<app-client-guid>
# Okta (API token in the secret store as "okta_api_token")
OPLIA_IDENTITY_OKTA_ORG_URL=https://<org>.okta.com
# Active Directory over LDAPS (bind password in the secret store as "ad_bind_password")
OPLIA_IDENTITY_AD_URL=ldaps://dc1.corp.example.com
OPLIA_IDENTITY_AD_BIND_DN=CN=svc-oplia,OU=Service Accounts,DC=corp,DC=example,DC=com
OPLIA_IDENTITY_AD_BASE_DN=DC=corp,DC=example,DC=com
OPLIA_IDENTITY_AD_CA_CERT_FILE=/etc/oplia/ad-ca.pem
# JIT
OPLIA_IDENTITY_CATALOG_PATH=/etc/oplia/jit-roles.json
OPLIA_IDENTITY_STANDING_ALLOWLIST={"entra:00000000-0000-0000-0000-0000000000a1": ["<break-glass-object-id>"]}
OPLIA_IDENTITY_REMOVE_STANDING_MEMBERS=false
# 90-day sweep
OPLIA_IDENTITY_INACTIVE_DAYS=90
OPLIA_IDENTITY_SWEEP_MAX_PER_RUN=25
OPLIA_IDENTITY_EXEMPT_USERS={"entra": ["breakglass1@corp.example.com"], "ad": ["svc-backup"]}
