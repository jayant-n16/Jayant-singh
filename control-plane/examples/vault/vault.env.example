# OPLIA control plane -> Vault (ConfigMap "oplia-vault"). No secrets in this file.
OPLIA_SECRET_PROVIDER=vault
OPLIA_VAULT_ADDR=https://vault.example.internal:8200
# PEM bundle of a private CA (mount it into the pod); leave empty for a publicly trusted certificate
OPLIA_VAULT_CA_CERT=
# OPLIA_VAULT_NAMESPACE=admin/oplia          # Vault Enterprise / HCP only
OPLIA_VAULT_AUTH_METHOD=kubernetes
OPLIA_VAULT_KUBERNETES_MOUNT=kubernetes-aws  # the auth path of the cluster the pod runs in
OPLIA_VAULT_KUBERNETES_ROLE=oplia-control-plane
# AppRole instead (daemons outside Kubernetes): role_id and secret_id are files, never env values
# OPLIA_VAULT_AUTH_METHOD=approle
# OPLIA_VAULT_APPROLE_ROLE_ID_FILE=/etc/oplia/vault/role_id
# OPLIA_VAULT_APPROLE_SECRET_ID_FILE=/etc/oplia/vault/secret_id
OPLIA_VAULT_CACHE_SECONDS=300
# Secret names resolve to secret/data/coc/<name>, field "value" (unchanged OPLIA paths)
OPLIA_VAULT_KV_MOUNT=secret
OPLIA_VAULT_KV_PREFIX=coc
# DR circuit breaker: encrypt incident dumps and sign Kafka bundles with Transit
OPLIA_DR_TRANSIT_MOUNT=transit-dr-broker
OPLIA_DR_TRANSIT_KEY=circuit-breaker-key
OPLIA_DR_SIGN_BUNDLES=true
