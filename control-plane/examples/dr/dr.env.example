# One oplia-dr-breaker process per replication stream.
OPLIA_DR_STREAM=orders-pg
OPLIA_DR_SOURCE_FORMAT=debezium            # sql | debezium | mongo_change | mongo_command | crdb_changefeed
OPLIA_DR_SOURCE_ENGINE=postgres            # postgres | mysql | mongodb | cockroachdb
OPLIA_DR_SQL_DIALECT=postgres
OPLIA_DR_SOURCE_TOPICS=["cdc.public.accounts","cdc.public.orders"]
OPLIA_DR_SINK_TOPIC=dr.orders
OPLIA_DR_KAFKA_SOURCE={"bootstrap.servers":"kafka-bootstrap.oplia-data.svc:9093","group.id":"oplia-dr-orders","security.protocol":"SASL_SSL","sasl.mechanism":"SCRAM-SHA-512","sasl.username":"oplia-dr","auto.offset.reset":"earliest"}
OPLIA_DR_KAFKA_SINK={"bootstrap.servers":"kafka-dr.example.net:9093","security.protocol":"SASL_SSL","sasl.mechanism":"SCRAM-SHA-512","sasl.username":"oplia-dr"}
OPLIA_DR_KAFKA_SASL_PASSWORD_SECRET=dr_kafka_password
# DR targets switched to read-only on a trip (DSNs are secrets; PG/CRDB DSNs must point at the database itself)
OPLIA_DR_TARGETS=[{"name":"dr-azure-pg","engine":"postgres","cloud":"azure","dsn_secret":"dr_azure_pg_dsn","database":"orders"},{"name":"dr-gcp-mysql","engine":"mysql","cloud":"gcp","dsn_secret":"dr_gcp_mysql_dsn"},{"name":"dr-ibm-mongo","engine":"mongodb","cloud":"ibm","dsn_secret":"dr_ibm_mongo_uri"}]
# Incident webhooks receive the complete dump (HMAC-signed). They may contain business data: restrict who can read them.
OPLIA_DR_WEBHOOKS=[{"url_secret":"dr_soc_webhook_url","hmac_secret":"dr_soc_webhook_hmac"}]
OPLIA_DR_SPIKE_PERCENT=500
OPLIA_DR_WINDOW_SECONDS=60
OPLIA_DR_BASELINE_WINDOWS=5
OPLIA_DR_MIN_MUTATIONS=1000
OPLIA_DR_QUARANTINE_DIR=/var/lib/oplia/dr-quarantine
